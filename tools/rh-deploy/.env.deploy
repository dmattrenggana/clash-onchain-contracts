# Robinhood Chain deployment config (public addresses only — no secrets here)
# The deployer key must belong to RH_ADMIN, because the constructor grants
# DEFAULT_ADMIN_ROLE to `admin_` and only that role can run
# grantRole / setGameServer / addCardType / setChestCost / setUpgradeCost.

RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# $CLASH on Robinhood Chain — bridged from Base (same token, same economics)
RH_TOKEN_ADDRESS=0xe577182a9a29af25675b3563f3b96aa948b5df19

# Same wallets as Base:
#   Base cards.admin  = 0x43d9A5Cb... (also the reward-claim signer + GAME_SERVER_ROLE holder)
#   Base treasury     = 0x3e419a79... (also the royalty receiver)
RH_ADMIN=0x43d9A5Cb3c0299E3De882E10036eE9DE0497f234
RH_TREASURY=0x3e419a7949AF95194471Ea293d9a3BE821d3a991
RH_ROYALTY=0x3e419a7949AF95194471Ea293d9a3BE821d3a991

# Signs the chest/pack requests (GAME_SERVER_ROLE)
RH_GAME_SERVER=0x43d9A5Cb3c0299E3De882E10036eE9DE0497f234
# Signs the match reward EIP-712 payload (ADMIN_PRIVATE_KEY)
RH_REWARD_SIGNER=0x43d9A5Cb3c0299E3De882E10036eE9DE0497f234
